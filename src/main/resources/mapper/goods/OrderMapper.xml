<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ha.springbootdemo.modules.goods.mapper.OrderMapper">

    <insert id="generateOrder">
        insert into koa_news_admin.`order` (goodsId, userId)
        values (#{goodsId}, #{userId})
    </insert>

</mapper>