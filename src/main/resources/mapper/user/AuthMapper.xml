<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ha.springbootdemo.modules.user.mapper.AuthMapper">

    <select id="login" resultType="com.ha.springbootdemo.modules.user.entity.User">
        SELECT *
        FROM koa_news_admin.user
        where phone = #{phone}
    </select>

    <select id="getMenusByUserRole" resultType="com.ha.springbootdemo.modules.user.entity.Menu">
        SELECT m.*
        FROM koa_news_admin.role_menu rm
                 inner join koa_news_admin.menu m on rm.menu_id = m.id
        where role_id = #{roleId}
    </select>

</mapper>
